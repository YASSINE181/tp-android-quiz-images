<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9"
    tools:context=".MainActivity">

    <!-- =================================================================== -->
    <!-- BANDEAU SUPÉRIEUR FIXE (Titre, Score en haut à droite, Progression) -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Ligne Titre + Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <!-- Score toujours visible en haut à droite -->
            <TextView
                android:id="@+id/txt_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/score_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Score : 0 / 5"
                android:textColor="@color/score_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Barre de progression horizontale -->
        <ProgressBar
            android:id="@+id/progress_quiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:max="5"
            android:progress="0"
            android:progressTint="@color/primary" />

        <!-- Texte de progression -->
        <TextView
            android:id="@+id/txt_progression_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Progression : 0 / 5 questions répondues"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- ZONE SCROLLABLE POUR GARANTIR L'ACCESSIBILITÉ SUR TOUS LES ÉCRANS   -->
    <!-- =================================================================== -->
    <ScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========================================== -->
            <!-- 1. ZONE QUESTION DU QUIZ (visible en jeu)  -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layout_question_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Numéro de la question -->
                <TextView
                    android:id="@+id/txt_numero_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 1 sur 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Carte Image de la question -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/img_question"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:contentDescription="Illustration de la forme géométrique"
                        android:src="@drawable/triangle" />
                </FrameLayout>

                <!-- Texte de la question posée -->
                <TextView
                    android:id="@+id/txt_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Combien de côtés possède cette forme ?"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="14dp" />

                <!-- Bouton Choix 1 -->
                <Button
                    android:id="@+id/btn_choix1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="52dp"
                    android:text="Choix 1"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Bouton Choix 2 -->
                <Button
                    android:id="@+id/btn_choix2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:minHeight="52dp"
                    android:text="Choix 2"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Bouton Choix 3 -->
                <Button
                    android:id="@+id/btn_choix3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:minHeight="52dp"
                    android:text="Choix 3"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Zone de retour / feedback sur la réponse -->
                <TextView
                    android:id="@+id/txt_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="12dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:text="✓ Bonne réponse ! Bravo !" />

                <!-- Bouton de navigation (Question suivante / Voir résultat) -->
                <Button
                    android:id="@+id/btn_suivant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:text="@string/btn_suivant"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- 2. ZONE RÉSULTAT FINAL (visible fin de jeu)-->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layout_resultat_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Icône décorative étoile finale -->
                <ImageView
                    android:id="@+id/img_resultat_decor"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/etoile"
                    android:contentDescription="Icône de fin de quiz"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/txt_titre_resultat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titre_resultat"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txt_score_final"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Votre score final : 5 / 5"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_pourcentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Réussite : 100%"
                    android:textSize="18sp"
                    android:textColor="@color/primary_dark"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/txt_appreciation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Félicitations ! Un sans-faute remarquable !"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="28dp" />

                <!-- Bouton Rejouer -->
                <Button
                    android:id="@+id/btn_rejouer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:text="@string/btn_rejouer"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
